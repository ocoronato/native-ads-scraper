# ---------------------------------------------------------------------------
# Credenciais do Cloudflare R2 (opcional).
#
# Sem elas o projeto funciona: a coleta roda normal e o site usa as URLs do
# CDN da propria rede de ads. O R2 serve pra guardar a imagem em resolucao
# cheia, que e o que some quando o anunciante tira a campanha do ar.
#
# Copie para `.env` e preencha. O `.env` esta no .gitignore.
# Alternativa: `python configurar_r2.py`, que grava em r2.config.json sem
# que a senha passe pela linha de comando ou pelo historico do shell.
#
# As variaveis tem prioridade sobre o r2.config.json — util em CI, onde o
# segredo vem do cofre do runner e nenhum arquivo e escrito em disco.
# ---------------------------------------------------------------------------

# Painel da Cloudflare > o ID aparece na URL e na barra lateral da conta.
R2_ACCOUNT_ID=00000000000000000000000000000000

# R2 > Manage API Tokens > Create API Token.
# Permissao necessaria: Object Read & Write, restrita a ESTE bucket.
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nome do bucket que voce criou.
R2_BUCKET=native-ads

# R2 > seu bucket > Settings > Public access > R2.dev subdomain > Allow.
# E a URL publica que serve as imagens pro site.
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
